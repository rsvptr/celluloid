# ----------------------------------------------------------------------------
# Celluloid environment variables
#
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local`; it is already gitignored. Next.js, Prisma and every operator
# script read the same files in the same order: variables already set in the
# shell win, then `.env.local`, then `.env` for anything still missing.
#
# Every value below is a placeholder. The app validates its settings in
# src/lib/env.ts when it starts and refuses to run with a clear message when a
# required one is missing or malformed.
#
# "Production" below means a Vercel Production deployment, or `next start` on
# your own server. Vercel Preview deployments, `npm run dev`, local builds and
# CI use the relaxed rules.
# ----------------------------------------------------------------------------


# --- Database (Neon Postgres) ------------------------------------------------

# Required. Neon's POOLED connection string (the host contains "-pooler").
# The running app connects with it through pg.
#   - It may use sslmode=verify-full. pg 8 treats require as verify-full but
#     logs a security warning, and pg 9 will adopt libpq's require, which skips
#     the certificate check.
#   - Keep Neon's channel_binding=require. With DIRECT_URL and
#     DATABASE_URL_UNPOOLED unset, migrations fall back to this URL, and
#     Prisma's migration engine turns verify-full into prefer, which allows
#     plaintext unless channel binding is required.
#   - Locally, point it at a Neon dev branch, never production: a stray
#     `prisma migrate` or test run uses whatever is here.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Recommended, and set it on Vercel Production. Neon's DIRECT connection
# string for the same branch: the same host without "-pooler", as the Connect
# dialog shows it with connection pooling turned off. Used by Prisma Migrate,
# `npm run db:indexes` and the backfill script, never by the running app,
# because Prisma Migrate takes a session-level lock that Neon's pooler can't
# hold.
#   - Precedence: DIRECT_URL, then DATABASE_URL_UNPOOLED, then DATABASE_URL.
#     A blank value counts as unset. Whichever wins has "-pooler" removed from
#     its host, so a pooled string is never used for migrations.
#   - It must name the same Neon endpoint and database as DATABASE_URL. If
#     either differs, Prisma commands that connect to a database, db:indexes
#     and the backfill refuse to run, so a production string left here can't
#     be migrated by accident.
#   - Keep sslmode=require&channel_binding=require, here, in
#     DATABASE_URL_UNPOOLED and in PROD_DATABASE_URL. Prisma's migration engine
#     doesn't support verify-full and silently falls back to prefer.
#   - Locally it can stay commented out, and migrations use DATABASE_URL on
#     its direct host (with the sslmode caveat above).
# DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional. The direct string under the name `neon env pull` and Neon's Vercel
# integration write. Used for migrations only when DIRECT_URL is unset, with
# the same same-branch check.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional, local only. The PRODUCTION connection string, for applying
# migrations from your machine while DATABASE_URL points at a dev branch:
#
#   npm run db:dump -- --target prod     full snapshot under backups/ first
#   npm run db:deploy:prod               apply pending migrations
#   npm run db:backfill:discovered-at -- --target prod
#
# Nothing else reads it and it never serves app traffic. A pooled string also
# works: these scripts connect to the same branch's direct host. db:deploy:prod
# only runs `prisma migrate deploy` (forward-only, it never resets or drops),
# and shows the Neon endpoint, the database and the pending migrations before
# asking you to type `deploy`. Don't set it on Vercel: Production builds
# migrate with their own DATABASE_URL and DIRECT_URL.
# PROD_DATABASE_URL="postgresql://USER:PASSWORD@ep-prod-654321.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# --- TMDB (metadata and images) ----------------------------------------------

# Required. The v4 "API Read Access Token" from
# https://www.themoviedb.org/settings/api (the long token starting with eyJ),
# not the 32-character v3 "API Key". Server side only.
#   - A v3 API key is refused everywhere.
#   - In production anything that isn't shaped like the Read Access Token (a
#     JWT) is refused too, so a Vercel Production build fails without it.
#     Elsewhere any other placeholder is accepted, which keeps CI working.
TMDB_ACCESS_TOKEN="eyJ...your-v4-read-access-token..."

# Test only. The end-to-end suite points the server at its local TMDB stub
# (e2e/tmdb-stub.mjs) with this. Leave it unset everywhere else. Production
# ignores it; elsewhere a set value must be an http(s) URL on localhost,
# 127.0.0.1 or [::1], or the app refuses to start.
# TMDB_API_BASE_URL="http://127.0.0.1:3101"


# --- Auth (Better Auth) ------------------------------------------------------

# Required. Signs sessions and encrypts two factor secrets and backup codes.
# At least 32 characters; the app refuses to start below that. Don't replace
# it once accounts use two factor: see "Rotating BETTER_AUTH_SECRET" in the
# README and use BETTER_AUTH_SECRETS below instead.
# Generate with: npx auth@latest secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# Optional. Versioned secrets for rotating BETTER_AUTH_SECRET, newest first,
# as "<version>:<secret>" pairs. Read by Better Auth itself. Leave
# BETTER_AUTH_SECRET unchanged when you add it.
# BETTER_AUTH_SECRETS="2:your-new-secret-from-npx-auth-secret"

# Required in production. The app's origin: scheme, host and port only, no
# path or trailing slash. It must match NEXT_PUBLIC_SITE_URL, and production
# requires HTTPS. In development either one falls back to the other, then to
# http://localhost:3000.
#   Local: http://localhost:3000   Production: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Required in production. The same origin as BETTER_AUTH_URL. Used for page
# metadata and by the browser's auth client. It is compiled into the client,
# so rebuild after changing it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Needed to create accounts. Every email sign up must present this shared
# code. At least 16 characters. Leave it blank to hide sign up and reject new
# accounts; existing users can still sign in. Set it while people you trust
# are joining, then rotate or remove it.
# Generate with: openssl rand -base64 24
SIGNUP_INVITE_CODE=""


# --- Secrets encryption ------------------------------------------------------

# Required in production, at least 32 characters there. Encrypts each user's
# Anthropic API key at rest (AES-256-GCM). In development and Preview it may be
# blank, and BETTER_AUTH_SECRET is used instead. Changing it makes stored keys
# unreadable until each person saves theirs again.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""


# --- AI suggestions (Anthropic Claude) ---------------------------------------

# Optional. A deployment wide key, used when a user hasn't saved their own in
# Settings. Without either, the recommend page can't run. Get one at
# https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-api03-your-key-here"

# Optional. The most recommendation runs the shared ANTHROPIC_API_KEY may make
# per UTC day, across all accounts and whatever the model. A whole number from
# 1 up. Blank or unset means uncapped. Runs on a personal key don't count, and
# a run that fails before Claude starts answering is given back. The counter
# table ships with the migrations (`npm run db:deploy`).
SHARED_AI_DAILY_RUN_LIMIT="20"


# --- Scheduled metadata sync -------------------------------------------------

# Optional, but needed for the nightly job. The bearer token the daily
# /api/cron/sync request (vercel.json, 07:00 UTC) must present. That run
# refreshes the shows you are watching and deletes Account activity entries
# older than 90 days. Blank disables it: the endpoint refuses every request
# rather than running unauthenticated. On Vercel, set it on the project and
# scheduled runs send it automatically. Nothing checks its length, so generate
# it rather than inventing one.
# Generate with: openssl rand -base64 32
CRON_SECRET=""


# --- Legacy workbook import (`npm run import` and `npm run db:seed` only) ----

# Required by the import script, which exits when it is unset or when no
# account with this email exists yet. The running app never reads it.
OWNER_EMAIL="you@example.com"

# Optional. The workbook to import. Defaults to data/watched.xlsx.
# IMPORT_FILE="data/watched.xlsx"


# --- End-to-end tests (`npm run test:e2e` only) ------------------------------

# Optional. The throwaway Postgres the Playwright suite migrates and fills with
# test accounts. It must be on localhost or 127.0.0.1; the suite refuses any
# other host. Defaults to the value below. The suite's server gets it as its
# DATABASE_URL, along with its own placeholder secrets, over `.env.local`.
# E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/celluloid_e2e"


# --- Not read from this file -------------------------------------------------
#
# ALLOW_DB_PUSH=1 lets `npm run db:push` run, for a throwaway database only.
# The guard reads the shell environment, never .env files, so type it on the
# command line each time: ALLOW_DB_PUSH=1 npm run db:push
#
# NODE_ENV, CI, VERCEL, VERCEL_ENV and NEXT_PHASE are set by Node, CI, Vercel
# and Next.js. Don't set them here.
#
# The optional preview-migrations workflow uses GitHub repository settings,
# not environment variables: a NEON_API_KEY secret and a NEON_PROJECT_ID
# variable (see "Deploying to Vercel" in the README).
