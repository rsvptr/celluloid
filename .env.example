# ----------------------------------------------------------------------------
# Celluloid environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# ----------------------------------------------------------------------------

# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"). Used at runtime by pg.
# It may use sslmode=verify-full: pg 8 treats require as verify-full but logs
# a security warning, and pg 9 will adopt libpq's require (no certificate
# check). Keep Neon's channel_binding=require: with DIRECT_URL and
# DATABASE_URL_UNPOOLED unset, migrations use this URL, and Prisma's
# migration engine turns verify-full into prefer, which allows plaintext;
# channel_binding=require makes it refuse a plaintext server.
# In local development this should be a Neon DEV BRANCH, never the production
# branch — a stray `prisma migrate` or a test run points at whatever is here.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/celluloid?sslmode=verify-full&channel_binding=require"
# Direct connection string: the same branch's host without "-pooler". Used for
# migrations, `npm run db:indexes` and the backfill script, never at runtime.
# Migrations must not go through the pooler, because Prisma Migrate takes a
# session-level lock that Neon's transaction-mode pooler can't hold. Uncomment
# and set it to the string Neon's Connect dialog shows with connection pooling
# turned off.
# When it is unset or blank, Prisma and the scripts use DATABASE_URL_UNPOOLED
# (the name `neon env pull` and Neon's Vercel integration write), then
# DATABASE_URL. Whichever is chosen has "-pooler" removed from its host, so
# the pooled string itself is never used.
# It must point at the SAME Neon branch and database as DATABASE_URL. If the
# endpoints or database names differ, Prisma commands that connect to a
# database, `db:indexes` and the backfill all refuse to run, so a production
# string left here can't be migrated by accident. DATABASE_URL_UNPOOLED gets
# the same check.
# Keep sslmode=require&channel_binding=require as Neon shows it, here, in
# DATABASE_URL_UNPOOLED and in PROD_DATABASE_URL. Prisma's migration engine
# doesn't support verify-full and silently falls back to prefer, which allows
# plaintext.
# DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/celluloid?sslmode=require&channel_binding=require"

# --- Promoting a schema migration to production ---
# Migrations are developed and verified against the dev branch above, then
# applied to production explicitly. Put the PRODUCTION direct string here
# (never in DATABASE_URL) and run:
#
#   npm run db:deploy:prod
#
# That script refuses to run unless PROD_DATABASE_URL is set, and it only ever
# runs `prisma migrate deploy` (forward-only — it never resets or drops). This
# variable never serves app traffic. A pooled string also works: the script and
# `npm run db:dump -- --target prod` both connect to that branch's direct host.
# Before asking for confirmation, the script shows the Neon endpoint, the
# database and the pending migrations, and warns if prisma/migrations has
# uncommitted changes.
# Vercel deployments run their own `prisma migrate deploy` at build time for
# the production environment, so this is for applying a migration ahead of, or
# independently of, a deploy.
# PROD_DATABASE_URL="postgresql://user:password@ep-prod.region.aws.neon.tech/celluloid?sslmode=require&channel_binding=require"

# --- TMDB (metadata) ---
# The v4 "API Read Access Token" from https://www.themoviedb.org/settings/api
# (the long token beginning with "eyJ..."). Server-side only.
TMDB_ACCESS_TOKEN="eyJ..."
# Test only. The end-to-end suite points the server at its local TMDB stub
# (e2e/tmdb-stub.mjs) with this; leave it unset everywhere else. A production
# deployment ignores it, and any other value must be an http(s) URL.
# TMDB_API_BASE_URL="http://127.0.0.1:3101"

# --- Auth (Better Auth) ---
# A long random secret, at least 32 characters. Startup fails below that.
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The app's base URL. Dev: http://localhost:3000  Prod: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
# New accounts are invite-only. Generate a shared code, give it only to people
# you want to join, then rotate or remove it after they have signed up. At least
# 16 characters; leaving it blank hides sign-up and rejects new accounts.
# Generate with: openssl rand -base64 24
SIGNUP_INVITE_CODE=""

# --- Secrets encryption ---
# Encrypts per-user Anthropic API keys at rest. Generate: openssl rand -base64 32
# REQUIRED in production - it cannot fall back to BETTER_AUTH_SECRET there, and
# must be at least 32 characters (the command above yields 44).
# Only in development/test may it be left unset, where it falls back to
# BETTER_AUTH_SECRET.
ENCRYPTION_KEY="replace-with-a-long-random-string"

# --- AI suggestions (Anthropic / Claude) ---
# Optional deployment-default key, used when a user hasn't added their own in Settings.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Maximum recommendation runs across all users on the shared key per UTC day.
# Personal keys bypass this counter. Blank/unset keeps shared use uncapped.
# Its counter table ships as a migration; `npm run db:migrate` applies it —
# new installs get it automatically.
SHARED_AI_DAILY_RUN_LIMIT="20"

# --- Scheduled metadata sync ---
# Bearer token the daily /api/cron/sync job must present. It guards an endpoint
# that rewrites library metadata, so treat it as key material: a long random
# secret, 32 characters or more. Nothing checks its length the way startup
# checks BETTER_AUTH_SECRET and ENCRYPTION_KEY, so generate it rather than
# inventing one: openssl rand -base64 32
# Leaving it unset disables the scheduled sync: the endpoint refuses every
# request rather than falling back to running unauthenticated, so the only thing
# lost is the nightly refresh. On Vercel, set it on the project and it is sent
# with scheduled invocations automatically.
CRON_SECRET=""

# --- App ---
# Public base URL, used for metadata and the auth client. Match BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Import / seeding (only used by `npm run import`, not the running app) ---
# Required: the import script throws if unset.
OWNER_EMAIL="you@example.com"
# Optional: path to the Excel file to import. Defaults to data/watched.xlsx.
IMPORT_FILE="data/watched.xlsx"
