{
  "name": "celluloid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && (if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; fi) && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:prod": "node scripts/deploy-prod-migrations.mjs",
    "db:dump": "node --import tsx scripts/db-dump.mjs",
    "db:check": "node --import tsx scripts/db-check.mjs",
    "db:backfill:discovered-at": "node --import tsx scripts/backfill-discovered-at.mjs",
    "db:push": "prisma db push && npm run db:indexes",
    "db:indexes": "node --import tsx scripts/ensure-indexes.mjs",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "import": "tsx scripts/import-excel.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.16",
    "better-auth": "^1.6.14",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.3.3",
    "pg": "^8.21.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "kysely": "0.28.17",
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  }
}
