// Celluloid — Prisma 7 schema
// Runtime connection comes from the @prisma/adapter-pg driver adapter (src/lib/prisma.ts).
// Migration/CLI connection comes from prisma.config.ts (DIRECT_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core models)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Per-user Anthropic API key, encrypted at rest (AES-256-GCM). Never plaintext.
  anthropicKeyEnc String?

  // Preferred Claude model for AI recommendations (null → server default).
  recommendModel String?

  // Localization preferences.
  timeZone    String @default("UTC")
  watchRegion String @default("US") // ISO 3166-1 region for release/provider lookups

  // Last successful backup download, so Settings can say how stale the owner's
  // off-site copy is. Advisory only — nothing in the app depends on it.
  lastBackupAt DateTime?

  // TMDB watch-provider ids the owner actually subscribes to, to answer "what
  // can I watch tonight without paying for anything new". Set from the picker
  // in Settings; the library's "On my services" filter reads it against
  // Title.streamProviderIds below, which the scheduled sync keeps warm.
  myProviders Int[] @default([])

  twoFactorEnabled Boolean? @default(false)

  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]
  authEvents AuthEvent[]

  // App relations
  titles       Title[]
  tags         Tag[]
  shareLists   ShareList[]
  watchEvents  WatchEvent[]
  importJobs   ImportJob[]
  suppressions Suppression[]

  @@map("user")
}

/**
 * A suggestion the owner explicitly does not want to see again.
 * The recommend page used to hold rejections in a component ref, so they died on
 * reload and a title turned down last week came straight back — burning API
 * budget re-deriving a pick already refused. This makes the refusal durable.
 * Keyed by `matchKey` rather than tmdbId because a suggestion may never resolve
 * to a TMDB entry (regional titles often don't), and those are exactly the ones
 * worth suppressing. The key is "tmdb:<MediaType>:<id>" when matched and
 * "name:<type>:<normalized name>|<year>" otherwise — the same normalization the
 * recommendation de-duplicator already uses.
 */
model Suppression {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchKey  String
  tmdbId    Int?
  mediaType MediaType
  name      String
  year      Int?
  reason    SuppressionReason @default(NOT_INTERESTED)

  createdAt DateTime @default(now())

  @@unique([userId, matchKey])
  @@index([userId])
}

enum SuppressionReason {
  NOT_INTERESTED
  SEEN_ELSEWHERE
}

// A public, read-only snapshot/view of a user's library or a selection of it.
// Reached via an unguessable slug at /s/[slug] (no auth).
model ShareList {
  id               String   @id @default(cuid())
  slug             String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String?
  titleIds         String[] @default([]) // empty = whole library; else explicit selection
  includeNotes     Boolean  @default(false)
  // Whole-library shares hide not-yet-watched WATCHLIST titles unless this is set.
  includeWatchlist Boolean  @default(false)

  // Scope + lifecycle. `titleIds` is retained during the transition to
  // ShareListItem and will be dropped in a later migration.
  scope     ShareScope @default(SELECTION)
  expiresAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  items ShareListItem[]

  @@index([userId])
}

model TwoFactor {
  id          String  @id
  secret      String
  backupCodes String
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean @default(true)

  // Better Auth's account-lockout state (NIST SP 800-63B §5.2.2), counted
  // across challenges and factors rather than per challenge. These are not
  // optional: on a sign-in TOTP or backup-code verification the plugin ALWAYS
  // writes them — resetTwoFactorFailures on success, an atomic increment on
  // failure. While the columns were absent, Prisma rejected that write, so a
  // correct code returned a 500 and 2FA sign-in could not complete at all;
  // the lockout itself also never engaged, because lockedUntil read as
  // undefined. Keep these in step with better-auth's two-factor schema.
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session listing/revocation in Settings queries by userId, and a user-row
  // delete cascades through here; without the index both walk the whole table.
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Credential lookups and the user-delete cascade both filter on userId.
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Better Auth's durable rate-limit counters, enabled by `rateLimit.storage:
// "database"` in src/lib/auth.ts. One short-lived row per (endpoint, client)
// key; Better Auth creates it with count/lastRequest, rewrites it in place each
// request within the window, and lets it lapse after. Field names and types are
// fixed by Better Auth's adapter (key/count/lastRequest, lastRequest a bigint
// epoch-ms); the model name maps to `prisma.rateLimit`, which is the accessor
// its Prisma adapter looks up. No application code reads or writes this table.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// Auth audit trail (BA-15): one row per sign-in, sign-out and security change,
// written by the hooks in src/lib/auth.ts through src/lib/auth-events.ts. The
// session rows can't serve, because a password change or "Sign out everywhere
// else" deletes them. `type` is a short event name that the code validates
// (AUTH_EVENT_TYPES). No email and no secrets are stored, and the user agent is
// cut to 200 characters. The nightly cron deletes rows older than 90 days.
model AuthEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Settings lists a user's latest events.
  @@index([userId, createdAt])
}

// One global reservation counter per UTC day for recommendation runs that use
// the deployment's shared Anthropic key. Personal-key runs never touch it.
model SharedAiDailyUsage {
  day      DateTime @id @db.Date
  runCount Int      @default(0)
}

// ---------------------------------------------------------------------------
// Library domain
// ---------------------------------------------------------------------------

enum MediaType {
  MOVIE
  TV
}

enum WatchStatus {
  WATCHLIST // want to watch (legacy "Unwatched")
  WATCHING // in progress (legacy "Partially Watched")
  WATCHED // completed
  ON_HOLD
  DROPPED
}

model Title {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata (TMDB-enriched where available)
  tmdbId       Int?
  mediaType    MediaType
  name         String
  originalName String?
  overview     String?   @db.Text
  releaseDate  DateTime? @db.Date
  posterPath   String?
  backdropPath String?
  language     String? // ISO 639-1 original language
  tmdbRating   Float? // TMDB vote_average (0-10)
  runtime      Int? // minutes (movies)
  genres       String[]  @default([])

  // Personal tracking
  status    WatchStatus @default(WATCHLIST)
  rating    Float? // user rating 0.5-10 (half-star increments)
  notes     String?     @db.Text
  watchedAt DateTime? // when finished (movie) / overall
  favorite  Boolean     @default(false)

  // TV structure summary
  totalSeasons    Int?
  totalEpisodes   Int?
  watchedEpisodes Int  @default(0) // denormalized for fast progress display

  // Provenance
  source String? // "Movies" | "TV Shows" | "Malayalam" | "tmdb" | "manual"

  // Soft-delete + metadata-sync bookkeeping.
  deletedAt         DateTime?
  metadataSyncedAt  DateTime?
  metadataSyncState MetadataSyncState?
  metadataLastError String?

  // TV lifecycle, refreshed by the scheduled metadata sync. `tmdbStatus` is
  // TMDB's own string ("Returning Series", "Ended", "Canceled", ...) — stored
  // verbatim rather than mapped to an enum so a new TMDB value can't break a
  // sync. Together these distinguish "on hiatus" from "finished for good" and
  // drive the upcoming-episodes view.
  tmdbStatus         String?
  nextEpisodeAirDate DateTime? @db.Date

  // Cached streaming availability for the owner's region, refreshed by the same
  // sync. TMDB provider ids only — names and logos are resolved at render time.
  // These ride along on a request the sync makes anyway; the library's "On my
  // services" filter reads them against User.myProviders. The title page still
  // asks TMDB directly for what it shows today.
  streamProviderIds Int[]     @default([])
  providersRegion   String?
  providersSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons        Season[]
  tags           TitleTag[]
  watchEvents    WatchEvent[]
  importItems    ImportItem[]
  shareListItems ShareListItem[]

  @@unique([userId, mediaType, tmdbId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, mediaType])
  @@index([userId, deletedAt])
  // "What's airing soon" scans a narrow date window for one owner.
  @@index([userId, nextEpisodeAirDate])
  // The scheduled sync picks the least-recently-synced titles to refresh. It
  // asks for never-synced titles in a separate query rather than ordering NULLS
  // FIRST, because a btree is ASC NULLS LAST and that ordering could not have
  // been served by this index. See selectCandidates in lib/metadata-sync.
  @@index([userId, metadataSyncedAt])
}

model Season {
  id      String @id @default(cuid())
  titleId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  tmdbId       Int?
  seasonNumber Int
  name         String?
  overview     String?   @db.Text
  airDate      DateTime? @db.Date
  posterPath   String?
  episodeCount Int?

  episodes Episode[]

  @@unique([titleId, seasonNumber])
  @@index([titleId])
}

model Episode {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  tmdbId        Int?
  episodeNumber Int
  name          String?
  overview      String?   @db.Text
  airDate       DateTime? @db.Date
  runtime       Int?
  stillPath     String?

  watched   Boolean   @default(false)
  watchedAt DateTime?

  // Set when TMDB removes a watched episode; personal history stays preserved.
  withdrawnAt DateTime?

  // When this episode row was first materialized (e.g. via TMDB backfill).
  discoveredAt DateTime @default(now())

  watchEvents WatchEvent[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?

  createdAt DateTime @default(now())

  titles TitleTag[]

  // NOTE: a second, CASE-INSENSITIVE unique index exists on (userId, lower(name)),
  // created in migration 20260717221157_workflow_foundation. Prisma's schema
  // language cannot express a functional index, so it is invisible here — and
  // `prisma db push`, which syncs from THIS file rather than from the migration
  // history, will drop it. `npm run db:push` therefore chains
  // scripts/ensure-indexes.mjs to put it back. Do not remove that chaining:
  // findOrCreateTag depends on the index to lose the race safely (P2002) when two
  // requests create the same tag in different casings.
  @@unique([userId, name])
  @@index([userId])
}

model TitleTag {
  titleId String
  tagId   String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([titleId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Workflow foundation (MIGRATION-1)
// ---------------------------------------------------------------------------

enum WatchEventKind {
  TITLE_COMPLETED
  EPISODE_WATCHED
  REWATCH
}

enum WatchEventSource {
  MANUAL
  BULK
  IMPORT
  RESTORE
  BACKFILL
}

enum MetadataSyncState {
  OK
  PARTIAL
  FAILED
}

enum ImportJobStatus {
  PARSING
  READY_FOR_REVIEW
  COMMITTING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ImportItemAction {
  CREATE
  UPDATE
  SKIP
  CONFLICT
  FAILED
}

enum ShareScope {
  WHOLE_LIBRARY
  SELECTION
}

// Append-only log of watch activity (completions, episode watches, rewatches).
model WatchEvent {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId    String
  title      Title            @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodeId  String?
  // Watch activity is historical evidence, not episode-owned data. Metadata
  // refreshes replace Episode rows, so deleting one must detach this optional
  // locator rather than cascade-delete the event itself.
  episode    Episode?         @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  kind       WatchEventKind
  occurredAt DateTime
  source     WatchEventSource @default(MANUAL)
  note       String?          @db.Text
  createdAt  DateTime         @default(now())

  @@index([userId, occurredAt])
  @@index([titleId, occurredAt])
  // Postgres does not index a foreign key for you, and `episodeId` is read
  // without userId/titleId in the predicate by two paths that both scale with
  // the whole log: un-ticking an episode looks up its event directly, and every
  // Episode row deletion must find referencing events to SET NULL. Episode
  // deletes happen in bulk (re-match, purge, empty trash), so without this the
  // cost is one full scan per deleted row inside an interactive transaction.
  @@index([episodeId])
}

// A staged bulk-import run: parse -> review -> commit.
model ImportJob {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  status      ImportJobStatus
  summary     Json?
  createdAt   DateTime        @default(now())
  committedAt DateTime?

  items ImportItem[]

  @@index([userId, createdAt])
}

// One staged row within an ImportJob.
model ImportItem {
  id                String           @id @default(cuid())
  jobId             String
  job               ImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber         Int
  raw               Json
  normalized        Json
  proposedTmdbId    Int?
  proposedMediaType MediaType?
  matchScore        Float?
  action            ImportItemAction
  titleId           String?
  title             Title?           @relation(fields: [titleId], references: [id], onDelete: SetNull)
  errorCode         String?
  warning           String?
  attempts          Int              @default(0)

  @@unique([jobId, rowNumber])
  @@index([titleId])
}

// Explicit, ordered membership of a ShareList (supersedes ShareList.titleIds).
model ShareListItem {
  id          String    @id @default(cuid())
  shareListId String
  shareList   ShareList @relation(fields: [shareListId], references: [id], onDelete: Cascade)
  titleId     String
  title       Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  position    Int

  @@unique([shareListId, titleId])
  @@index([titleId])
}
