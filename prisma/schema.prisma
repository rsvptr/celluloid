// Celluloid — Prisma 7 schema
// Runtime connection comes from the @prisma/adapter-pg driver adapter (src/lib/prisma.ts).
// Migration/CLI connection comes from prisma.config.ts (DIRECT_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core models)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Per-user Anthropic API key, encrypted at rest (AES-256-GCM). Never plaintext.
  anthropicKeyEnc String?

  // Preferred Claude model for AI recommendations (null → server default).
  recommendModel String?

  // Localization preferences.
  timeZone    String @default("UTC")
  watchRegion String @default("US") // ISO 3166-1 region for release/provider lookups

  twoFactorEnabled Boolean? @default(false)

  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]

  // App relations
  titles      Title[]
  tags        Tag[]
  shareLists  ShareList[]
  watchEvents WatchEvent[]
  importJobs  ImportJob[]

  @@map("user")
}

// A public, read-only snapshot/view of a user's library or a selection of it.
// Reached via an unguessable slug at /s/[slug] (no auth).
model ShareList {
  id           String   @id @default(cuid())
  slug         String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  titleIds     String[] @default([]) // empty = whole library; else explicit selection
  includeNotes Boolean  @default(false)
  // Whole-library shares hide not-yet-watched WATCHLIST titles unless this is set.
  includeWatchlist Boolean @default(false)

  // Scope + lifecycle. `titleIds` is retained during the transition to
  // ShareListItem and will be dropped in a later migration.
  scope     ShareScope @default(SELECTION)
  expiresAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  items ShareListItem[]

  @@index([userId])
}

model TwoFactor {
  id          String  @id
  secret      String
  backupCodes String
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean @default(true)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Library domain
// ---------------------------------------------------------------------------

enum MediaType {
  MOVIE
  TV
}

enum WatchStatus {
  WATCHLIST // want to watch (legacy "Unwatched")
  WATCHING // in progress (legacy "Partially Watched")
  WATCHED // completed
  ON_HOLD
  DROPPED
}

model Title {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata (TMDB-enriched where available)
  tmdbId       Int?
  mediaType    MediaType
  name         String
  originalName String?
  overview     String?   @db.Text
  releaseDate  DateTime? @db.Date
  posterPath   String?
  backdropPath String?
  language     String? // ISO 639-1 original language
  tmdbRating   Float? // TMDB vote_average (0-10)
  runtime      Int? // minutes (movies)
  genres       String[]  @default([])

  // Personal tracking
  status    WatchStatus @default(WATCHLIST)
  rating    Float? // user rating 0.5-10 (half-star increments)
  notes     String?     @db.Text
  watchedAt DateTime? // when finished (movie) / overall
  favorite  Boolean     @default(false)

  // TV structure summary
  totalSeasons    Int?
  totalEpisodes   Int?
  watchedEpisodes Int  @default(0) // denormalized for fast progress display

  // Provenance
  source String? // "Movies" | "TV Shows" | "Malayalam" | "tmdb" | "manual"

  // Soft-delete + metadata-sync bookkeeping.
  deletedAt         DateTime?
  metadataSyncedAt  DateTime?
  metadataSyncState MetadataSyncState?
  metadataLastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons        Season[]
  tags           TitleTag[]
  watchEvents    WatchEvent[]
  importItems    ImportItem[]
  shareListItems ShareListItem[]

  @@unique([userId, mediaType, tmdbId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, mediaType])
  @@index([userId, deletedAt])
}

model Season {
  id      String @id @default(cuid())
  titleId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  tmdbId       Int?
  seasonNumber Int
  name         String?
  overview     String?   @db.Text
  airDate      DateTime? @db.Date
  posterPath   String?
  episodeCount Int?

  episodes Episode[]

  @@unique([titleId, seasonNumber])
  @@index([titleId])
}

model Episode {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  tmdbId        Int?
  episodeNumber Int
  name          String?
  overview      String?   @db.Text
  airDate       DateTime? @db.Date
  runtime       Int?
  stillPath     String?

  watched   Boolean   @default(false)
  watchedAt DateTime?

  // When this episode row was first materialized (e.g. via TMDB backfill).
  discoveredAt DateTime @default(now())

  watchEvents WatchEvent[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?

  createdAt DateTime @default(now())

  titles TitleTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TitleTag {
  titleId String
  tagId   String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([titleId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Workflow foundation (MIGRATION-1)
// ---------------------------------------------------------------------------

enum WatchEventKind {
  TITLE_COMPLETED
  EPISODE_WATCHED
  REWATCH
}

enum WatchEventSource {
  MANUAL
  BULK
  IMPORT
  RESTORE
  BACKFILL
}

enum MetadataSyncState {
  OK
  PARTIAL
  FAILED
}

enum ImportJobStatus {
  PARSING
  READY_FOR_REVIEW
  COMMITTING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ImportItemAction {
  CREATE
  UPDATE
  SKIP
  CONFLICT
  FAILED
}

enum ShareScope {
  WHOLE_LIBRARY
  SELECTION
}

// Append-only log of watch activity (completions, episode watches, rewatches).
model WatchEvent {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId    String
  title      Title            @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodeId  String?
  episode    Episode?         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  kind       WatchEventKind
  occurredAt DateTime
  source     WatchEventSource @default(MANUAL)
  note       String?          @db.Text
  createdAt  DateTime         @default(now())

  @@index([userId, occurredAt])
  @@index([titleId, occurredAt])
}

// A staged bulk-import run: parse -> review -> commit.
model ImportJob {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  status      ImportJobStatus
  summary     Json?
  createdAt   DateTime        @default(now())
  committedAt DateTime?

  items ImportItem[]

  @@index([userId, createdAt])
}

// One staged row within an ImportJob.
model ImportItem {
  id                String           @id @default(cuid())
  jobId             String
  job               ImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber         Int
  raw               Json
  normalized        Json
  proposedTmdbId    Int?
  proposedMediaType MediaType?
  matchScore        Float?
  action            ImportItemAction
  titleId           String?
  title             Title?           @relation(fields: [titleId], references: [id], onDelete: SetNull)
  errorCode         String?
  warning           String?
  attempts          Int              @default(0)

  @@unique([jobId, rowNumber])
  @@index([titleId])
}

// Explicit, ordered membership of a ShareList (supersedes ShareList.titleIds).
model ShareListItem {
  id          String    @id @default(cuid())
  shareListId String
  shareList   ShareList @relation(fields: [shareListId], references: [id], onDelete: Cascade)
  titleId     String
  title       Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  position    Int

  @@unique([shareListId, titleId])
  @@index([titleId])
}
